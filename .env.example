# Copy to .env and fill in. Never commit the real values.

# --- Database and admin -------------------------------------------------------
# Postgres. For development, see the one-line Docker command in the README.
DATABASE_URL=postgres://darrida:darrida@127.0.0.1:5433/darrida
# A long random string (e.g. `openssl rand -hex 32`). Signs admin sessions.
PAYLOAD_SECRET=
# The public address of the site, no trailing slash. Used in Stripe's return
# links and in email links to the admin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where uploaded photos are stored on disk. Keep it outside the app folder in
# production so deploys never touch it. Defaults to ./media.
MEDIA_DIR=

# --- Stripe -------------------------------------------------------------------
# Test keys work before the business bank account exists (Stripe dashboard →
# Developers → API keys). Swap for live keys when going live.
STRIPE_SECRET_KEY=
# From `stripe listen` in development, or the webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Customer accounts ------------------------------------------------------
# Signs customer sessions. A long random string, different from PAYLOAD_SECRET
# (falls back to PAYLOAD_SECRET if empty).
BETTER_AUTH_SECRET=
# "Continue with Google": an OAuth client from Google Cloud Console (APIs &
# Services → Credentials → OAuth client ID → Web application). Add
# {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google as an authorised redirect URI.
# Leave empty to hide the Google button; email codes work either way.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Before launch: the browser asks for this username and password on every page.
# Leave either empty to open the site to everyone.
SITE_USERNAME=
SITE_PASSWORD=
# 1 = every shop page shows the coming-soon picture (public/media/coming-soon.jpg).
# The admin keeps working. Turn the password above off while this is on.
COMING_SOON=

# --- Email (any SMTP provider) --------------------------------------------------
# Without SMTP_HOST, emails are written to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=orders@darrida.com

# --- Optional: `pnpm seed` ----------------------------------------------------
# Creates this admin if set (otherwise create the first admin at /admin).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Fills "Send new-order emails to" in Store settings.
SEED_NOTIFY_EMAIL=

# --- Admin -----------------------------------------------------------------------
# The admin's address. Not /admin (bots scan for it): /admin shows "page not found".
# Letters, digits and dashes; defaults to /atelier.
ADMIN_PATH=atelier

# --- Visitor analytics (Umami, self-hosted) -------------------------------------
# Leave empty to switch off: no tracking script on the shop, and the dashboard says
# "not connected yet". The username/password are an Umami login used only by the
# server to read the numbers for the admin dashboard.
UMAMI_URL=
# Where browsers load the tracking script, if not {UMAMI_URL}/script.js. In
# production: /stats/script.js (nginx passes it to Umami; see deploy/).
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_USERNAME=
UMAMI_PASSWORD=
