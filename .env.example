# Copy to .env.local and fill in. Never commit the real values.

# Shopify Storefront API (Shopify admin → Settings → Apps → Develop apps, or the Headless channel)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional; defaults to 2026-10
SHOPIFY_API_VERSION=2026-10

# The single "Custom Abaya" product variant every configurator design is added as,
# e.g. gid://shopify/ProductVariant/1234567890
SHOPIFY_CUSTOM_ABAYA_VARIANT_ID=
