# Copy to .env and fill in. Never commit the real values.

# --- Database and admin -------------------------------------------------------
# Postgres. For development, see the one-line Docker command in the README.
DATABASE_URL=postgres://darrida:darrida@127.0.0.1:5433/darrida
# A long random string (e.g. `openssl rand -hex 32`). Signs admin sessions.
PAYLOAD_SECRET=
# The public address of the site, no trailing slash. Used in Stripe's return
# links and in email links to the admin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where uploaded photos are stored on disk. Keep it outside the app folder in
# production so deploys never touch it. Defaults to ./media.
MEDIA_DIR=

# --- Stripe -------------------------------------------------------------------
# Test keys work before the business bank account exists (Stripe dashboard →
# Developers → API keys). Swap for live keys when going live.
STRIPE_SECRET_KEY=
# From `stripe listen` in development, or the webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Email (any SMTP provider) --------------------------------------------------
# Without SMTP_HOST, emails are written to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=orders@darrida.com

# --- Optional: `pnpm seed` ----------------------------------------------------
# Creates this admin if set (otherwise create the first admin at /admin).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Fills "Send new-order emails to" in Store settings.
SEED_NOTIFY_EMAIL=
