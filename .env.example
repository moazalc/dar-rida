# Copy to .env.local and fill in. Never commit the real values.

# Shopify Storefront API (Shopify admin → Settings → Apps → Develop apps, or the Headless channel)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional; defaults to 2026-10
SHOPIFY_API_VERSION=2026-10

# The single "Custom Abaya" product variant every configurator design is added as,
# e.g. gid://shopify/ProductVariant/1234567890. Tag that product "configurator"
# so it stays out of the Collection page.
SHOPIFY_CUSTOM_ABAYA_VARIANT_ID=

# Optional: the collection the Collection page lists (its handle). Without it, all products.
SHOPIFY_COLLECTION_HANDLE=
# Optional: market for prices/currency, as an ISO country code, e.g. AE
SHOPIFY_COUNTRY=
